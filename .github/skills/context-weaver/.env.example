# Context Weaver — LLM provider configuration
#
# Only needed if you run scripts/generate-descriptions.js directly (batch generation
# via an API). The primary path — the architect agent writing descriptions itself from
# context-workload.md — needs none of this.
#
# Copy to .env in this folder. Never commit .env; it holds real API keys and is
# gitignored on purpose.

# ---------------------------------------------------------------------------
# Provider selection — pick exactly one: anthropic | openai | google
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI --------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google (Gemini) -------------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash

# ---------------------------------------------------------------------------
# Generation tuning
# ---------------------------------------------------------------------------
# Thinking depth. Anthropic-only — silently ignored by openai/google, since
# "effort" is Claude-specific vocabulary with no equivalent lever there.
CONTEXT_EFFORT=high
# Nodes sent to the model per request.
CONTEXT_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# Node selection thresholds — same knobs list-context-workload.js exposes as CLI
# flags. A CLI flag passed explicitly always overrides the value here.
# ---------------------------------------------------------------------------
CONTEXT_TYPE_THRESHOLD=3
CONTEXT_METHOD_THRESHOLD=3
CONTEXT_MIN_PACKAGE_TYPES=2
CONTEXT_MAX_NODES=400
