{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story implementation plan",
  "type": "object",
  "required": ["approach", "affectedFiles", "acceptanceCriteriaPlan", "risks", "testHints"],
  "properties": {
    "approach": { "type": "string", "minLength": 1 },
    "affectedFiles": { "type": "array", "items": { "type": "string" } },
    "affectedSymbols": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteriaPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "change"],
        "properties": {
          "criterion": { "type": "string" },
          "change": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "testHints": { "type": "array", "items": { "type": "string" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
