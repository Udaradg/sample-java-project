{
  "base_url": "http://localhost:8080",
  "auth": { "type": "basic", "username": "demo", "password": "demo123" },
  "readiness": { "path": "/actuator/health", "timeout_seconds": 150 },
  "requests": [
    { "name": "health is public and UP", "method": "GET", "path": "/actuator/health", "no_auth": true, "expect_status": 200 },
    { "name": "info is public", "method": "GET", "path": "/actuator/info", "no_auth": true, "expect_status": 200 },
    { "name": "list all employees", "method": "GET", "path": "/api/v1/employees", "expect_status": 200 },
    { "name": "get employee by id", "method": "GET", "path": "/api/v1/employees/1", "expect_status": 200 },
    { "name": "search by department", "method": "GET", "path": "/api/v1/employees/search?department=Technology", "expect_status": 200 },
    { "name": "search is case-insensitive", "method": "GET", "path": "/api/v1/employees/search?department=technology", "expect_status": 200 },
    { "name": "high earners (native SQL path)", "method": "GET", "path": "/api/v1/employees/high-earners?salary=80000", "expect_status": 200 },
    { "name": "unknown employee is 404", "method": "GET", "path": "/api/v1/employees/99999", "expect_status": 404 },
    { "name": "update of unknown employee is 404", "method": "PUT", "path": "/api/v1/employees/99999", "expect_status": 404,
      "body": { "firstName": "ProbeOnly" } },
    { "name": "delete of unknown employee is 404", "method": "DELETE", "path": "/api/v1/employees/99999", "expect_status": 404 },
    { "name": "invalid create payload is 400", "method": "POST", "path": "/api/v1/employees", "expect_status": 400,
      "body": { "employeeNumber": "", "firstName": "Probe", "lastName": "Only", "email": "not-an-email", "department": "Technology", "salary": 85000 } },
    { "name": "missing required query parameter is 400", "method": "GET", "path": "/api/v1/employees/search", "expect_status": 400 },
    { "name": "unauthenticated list is 401", "method": "GET", "path": "/api/v1/employees", "no_auth": true, "expect_status": 401 },
    { "name": "unauthenticated create is 401", "method": "POST", "path": "/api/v1/employees", "no_auth": true, "expect_status": 401,
      "body": { "employeeNumber": "EMP999", "firstName": "Probe", "lastName": "Only", "email": "probe.only@example.com", "department": "Technology", "salary": 1000 } },
    { "name": "bad credentials are 401", "method": "GET", "path": "/api/v1/employees", "no_auth": true, "expect_status": 401,
      "headers": { "Authorization": "Basic ZGVtbzp3cm9uZy1wYXNzd29yZA==" } }
  ]
}
