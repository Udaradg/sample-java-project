{
  "base_url": "http://localhost:8080",
  "auth": { "type": "basic", "username": "demo", "password": "demo123" },
  "readiness": { "path": "/actuator/health", "timeout_seconds": 150 },
  "requests": [
    { "name": "health is public and UP", "method": "GET", "path": "/actuator/health", "no_auth": true, "expect_status": 200 },
    { "name": "info is public", "method": "GET", "path": "/actuator/info", "no_auth": true, "expect_status": 200 },
    { "name": "list all employees", "method": "GET", "path": "/api/v1/employees", "expect_status": 200 },
    { "name": "get employee by id", "method": "GET", "path": "/api/v1/employees/1", "expect_status": 200 },
    { "name": "unknown employee is 404", "method": "GET", "path": "/api/v1/employees/99999", "expect_status": 404 },
    { "name": "search by department", "method": "GET", "path": "/api/v1/employees/search?department=Technology", "expect_status": 200 },
    { "name": "high earners filter", "method": "GET", "path": "/api/v1/employees/high-earners?salary=80000", "expect_status": 200 },
    { "name": "invalid payload is 400", "method": "POST", "path": "/api/v1/employees", "expect_status": 400,
      "body": { "employeeNumber": "", "firstName": "John", "lastName": "Doe", "email": "not-an-email", "department": "Technology", "salary": 85000 } },
    { "name": "unauthenticated list is 401", "method": "GET", "path": "/api/v1/employees", "no_auth": true, "expect_status": 401 },
    { "name": "unauthenticated single is 401", "method": "GET", "path": "/api/v1/employees/1", "no_auth": true, "expect_status": 401 }
  ]
}
